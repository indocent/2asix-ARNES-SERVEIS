# Inventari de connexió al servidor Debian remot de l'arnés.
#
# Copia aquest fitxer a `inventory.env` a l'arrel del projecte i omple els
# valors reals. `inventory.env` està inclòs a .gitignore: NO el commitis mai
# i no hi posis cap credencial en aquest exemple.
#
# Carrega'l a la shell amb:
#   set -a; . ./inventory.env; set +a

# --- Accés SSH ---
# Nom o IP del servidor remot.
SSH_HOST=servidor.example.com
# Port SSH.
SSH_PORT=22
# Usuari SSH amb accés sudo.
SSH_USER=sysadmin
# Ruta a la clau privada. Deixa-ho buit per fer servir ssh-agent.
SSH_KEY=~/.ssh/id_ed25519
# 1 = executar les comandes remotes amb `sudo -n` (no interactiu).
# 0 = executar-les com l'usuari SSH (sense sudo).
SSH_SUDO=1

# --- Domini i xarxa ---
# Zona base dels clients: cada client penja de <client>.<ZONE_BASE>.
ZONE_BASE=example.com
# IP pública del servidor, on apunten els registres A dels clients.
SERVER_IP=203.0.113.10

# --- Rutes remotes ---
# Arrel dels webs estàtics.
WEB_ROOT=/var/www
# Directori de còpies de seguretat.
BACKUP_DIR=/var/backups/arnes
# Fitxer de traçabilitat d'operacions.
LOG_FILE=/var/log/arnes/operations.log
